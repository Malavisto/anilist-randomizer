{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Africa/Johannesburg",
  "dependencyDashboard": true,
  "schedule": [
    "* 0-9 * * 1"
  ],
  "minimumReleaseAge": "7 days",
  "automerge": true,
  "automergeType": "branch",
  "platformAutomerge": false,
  "prConcurrentLimit": 2,
  "packageRules": [
    {
      "description": "Batch routine updates; keep breaking upgrades separate so one failure does not block everything.",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "routine dependencies"
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": false
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "* 0-9 * * 1"
    ],
    "automerge": true
  }
}
